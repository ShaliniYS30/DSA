//Problem:String Compression
//Platform:Leetcode
//Difficulty:medium
//Language:c++
#include<bits/stdc++.h>
using namespace std;
int compress(vector<char>&chars){
    int n=chars.size();
    int i=0;
    int j=0;
    while(i<n){
        char ch=chars[i];
        int count=0;
        while(i<n&& chars[i]==ch){
            count++;
            i++;
        }
        chars[j++]=ch;
        if(count>1){
            string s=to_string(count);
            for(char c:s){
                chars[j++]=c;
            }
        }
    }
    return j;
}
int main(){
    string s;
    cout<<"Enter string";
    cin>>s;
    vector<char> chars(s.begin(),s.end());
    int len=compress(chars);
    cout<<"Compressed string:";
    for(int i=0;i<len;i++){
        cout<<chars[i];
    }
    cout<<"\nLength: "<<len;
    return 0;
}